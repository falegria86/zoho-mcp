# Credenciales OAuth de la app Zoho (https://api-console.zoho.com)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Nombre del portal; el servidor lo resuelve solo a ID numérico
ZOHO_PORTAL_NAME=

# zpuid del usuario (obtenerlo con list_users en cualquier proyecto)
ZOHO_MY_USER_ID=
ZOHO_MY_NAME=

# team-tasks
ZOHO_TEAM_EMAILS=
ZOHO_TEAM_NAMES=

# auto-timer
ZOHO_AUTO_TIMER_PROJECT_ID=
ZOHO_AUTO_TIMER_TASK_ID=

# aprobar-horas — equipo cuyas horas se aprueban cada mes.
# Emails separados por comas (recomendado) o fragmentos de nombre.
# Se puede sobrescribir sin tocar el .env con: --team="a@x.com,b@x.com"
ZOHO_APPROVAL_TEAM_NAME=Mi equipo
ZOHO_APPROVAL_TEAM=persona1@empresa.com,persona2@empresa.com
ZOHO_HOURS_PER_WEEK=45

# Solo en Railway/entornos sin filesystem persistente (reemplaza a tokens.json)
ZOHO_REFRESH_TOKEN=
